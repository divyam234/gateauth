# Required. Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
POSTGRES_PASSWORD=
SEED_ADMIN_PASSWORD=

APP_NAME=GateAuth
SEED_ADMIN_EMAIL=admin@example.com
BETTER_AUTH_URL=http://app.localhost
CORS_ORIGINS=http://app.localhost
TRUSTED_ORIGINS=http://app.localhost
DEFAULT_APPLICATION_HOST=app.localhost

# Production email delivery webhook. GateAuth POSTs JSON email payloads here.
MAIL_WEBHOOK_URL=
MAIL_WEBHOOK_TOKEN=
EMAIL_FROM=GateAuth <noreply@example.com>
REQUIRE_EMAIL_VERIFICATION=false

# Optional identity providers and bot protection.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
ENABLE_HIBP=true
