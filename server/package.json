{
  "name": "forward-auth-server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist --sourcemap=external",
    "typecheck": "bun --bun tsc --noEmit && bun --bun tsc -p tsconfig.test.json",
    "start": "bun src/index.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun src/migrate.ts",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "test:integration": "bun --bun vitest run --config vitest.integration.config.ts",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:push": "bun --bun drizzle-kit push",
    "db:check": "bun --bun drizzle-kit check"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.5",
    "@better-auth/passkey": "1.7.5",
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "ipaddr.js": "^2.5.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
